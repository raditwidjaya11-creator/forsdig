# Tripay Configurations (PPOB Provider 1)
TRIPAY_API_KEY=your_tripay_api_key
TRIPAY_PRIVATE_KEY=your_tripay_private_key
TRIPAY_MERCHANT_CODE=your_tripay_merchant_code
TRIPAY_MODE=sandbox # sandbox or production

# Digiflazz Configurations (PPOB Provider 2)
DIGIFLAZZ_USERNAME=your_digiflazz_username
DIGIFLAZZ_API_KEY=your_digiflazz_api_key
DIGIFLAZZ_MODE=sandbox # sandbox or production

# Supabase Frontend Configurations (Required for Login & Main DB)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Backend Configurations (Required for PPOB Sync & Admin actions)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# System Configurations
AUTO_SYNC_ON_START=true
NODE_ENV=development
